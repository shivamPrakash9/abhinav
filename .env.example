# =============================================================================
# Quizly — environment variables
# Copy to `.env` for local development. NEVER commit `.env`.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# =============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Random 32+ byte secrets: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
# Used to sign the short-lived Supabase Realtime JWTs and to hash IPs.
APP_SECRET="replace-me-openssl-rand-base64-32"
# Protects /api/cron/* routes (Vercel Cron sends this as `Authorization: Bearer <secret>`).
CRON_SECRET="replace-me-too"

# ---------------------------------------------------------------------------
# Database — Supabase Postgres via Prisma
# ---------------------------------------------------------------------------
# Runtime connection: Supavisor TRANSACTION pooler, port 6543.
# `pgbouncer=true` is required in transaction mode; `connection_limit=1` prevents
# every serverless instance from opening a large pool.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Migration/CLI connection: direct port 5432 (or session pooler). Prisma Migrate
# cannot run through a transaction pooler because it needs advisory locks.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Supabase — Realtime + Storage (NOT used for auth; Auth.js owns identity)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Bypasses RLS — never expose. No NEXT_PUBLIC_ prefix, ever.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="quiz-media"

# ---------------------------------------------------------------------------
# Auth.js v5 — Google + GitHub OAuth
# Callback URLs to register with each provider:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/github
#   https://your-domain.com/api/auth/callback/{google|github}
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---------------------------------------------------------------------------
# Upstash Redis — rate limiting
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Email — Resend (invites + results). Optional; code no-ops when unset.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Quizly <noreply@example.com>"

# ---------------------------------------------------------------------------
# Analytics + error monitoring (optional; code no-ops when unset)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
POSTHOG_API_KEY=""
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# ---------------------------------------------------------------------------
# Payments — Stripe (optional premium tier). The webhook route no-ops when unset.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_ID_PREMIUM_MONTHLY=""
